{
  "uid": "tee-trade-business",
  "title": "FUTBA — бизнес и конверсии",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "timezone": "browser",
  "tags": [
    "futba"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "window",
        "label": "Окно показателей",
        "type": "custom",
        "query": "24h,7d,30d,90d",
        "current": {
          "text": "7d",
          "value": "7d"
        },
        "options": [
          {
            "text": "24h",
            "value": "24h",
            "selected": false
          },
          {
            "text": "7d",
            "value": "7d",
            "selected": true
          },
          {
            "text": "30d",
            "value": "30d",
            "selected": false
          },
          {
            "text": "90d",
            "value": "90d",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Как читать дашборд",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Карточки показывают скользящее окно $window на текущий момент**, независимо от диапазона графиков в правом верхнем углу. Обновление данных — раз в минуту. Просмотр = открытие карточки; повторы одного посетителя и товара в одном 30-минутном интервале исключаются. Просмотры администратора и демотоваров из интерфейса не отправляются. Анонимные посетители определяются cookie, не являются точным числом людей."
      }
    },
    {
      "id": 2,
      "title": "Сбор бизнес-данных",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tee_business_collection_success",
          "legendFormat": "Сбор бизнес-данных",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "НЕДОСТУПНО",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "text": {
          "valueSize": 40,
          "titleSize": 12
        }
      }
    },
