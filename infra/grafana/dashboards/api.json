        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100*(sum(rate(http_requests_total{route=~\"/api/.*\",route=~\"$route\",status=~\"5..\"}[$__rate_interval])) or vector(0))/clamp_min(sum(rate(http_requests_total{route=~\"/api/.*\",route=~\"$route\"}[$__rate_interval])),0.000001)",
          "legendFormat": "Ответов 5xx, %",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Нет данных",
